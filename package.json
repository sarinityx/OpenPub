{
  "name": "openpub-workspace",
  "version": "1.2.1",
  "private": true,
  "description": "OpenPub: a desktop page-layout editor that opens Microsoft Publisher (.pub) files",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "postinstall": "cd desktop/appsrc && npm install --no-audit --no-fund",
    "build": "node tools/build.js",
    "start": "node tools/build.js && electron desktop/appsrc",
    "test": "node tools/build.js && node tools/e2e.js && node tools/e2e-desktop.js",
    "test:web": "node tools/build.js && node tools/e2e.js",
    "test:desktop": "node tools/build.js && node tools/e2e-desktop.js",
    "test:parser": "node tools/harness.js",
    "smoke": "node tools/build.js && node tools/smoke.js",
    "package:win": "node tools/package.mjs win32",
    "test:installer": "node tools/e2e-installer.js",
    "site:build": "node tools/build-site.js",
    "site:check": "node tools/build-site.js && node tools/site-check.js",
    "site:screenshots": "node tools/build.js && node tools/site-screenshots.js",
    "package:linux": "node tools/package.mjs linux"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.63.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
